        document.addEventListener("DOMContentLoaded", function () {
            afficherOptions("idPriorite", listesDeroulantes.priorite, "idPriorite", "priorite");
            afficherOptions("idTypeTache", listesDeroulantes.typeTache, "idTypeTache", "typeTache");
            afficherOptions("idEnvironnement", listesDeroulantes.environnement, "idEnvironnement", "environnement");
            afficherOptions("idStatut", listesDeroulantes.statut, "idStatut", "statut");
        });
    </script>
