<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SYNVAverse – ToDo List M2 SYNVA</title>

    
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%2322d3ee'/%3E%3Cstop offset='.5' stop-color='%232563eb'/%3E%3Cstop offset='1' stop-color='%237c3aed'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='14' fill='%230b1030'/%3E%3Cellipse cx='32' cy='32' rx='28' ry='9' fill='none' stroke='%23c4b5fd' stroke-width='2.5' opacity='.6' transform='rotate(-20 32 32)'/%3E%3Ccircle cx='32' cy='32' r='16' fill='url(%23g)'/%3E%3Cpath d='M24 33l6 6 11-12' fill='none' stroke='%23fff' stroke-width='5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">

    <style>
        :root {
            --nuit: #0b1030;
            --bleu-fonce: #1e3a8a;
            --bleu: #2563eb;
            --bleu-clair: #dbeafe;
            --violet: #7c3aed;
            --violet-clair: #ede9fe;
            --cyan: #22d3ee;
            --fond: #f1f5f9;
            --texte: #1e293b;
            --gris: #64748b;
            --bordure: #cbd5e1;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Segoe UI", Arial, Helvetica, sans-serif;
            background:
                radial-gradient(circle at 90% 10%, #e0e7ff 0%, transparent 35%),
                radial-gradient(circle at 5% 60%, #ede9fe 0%, transparent 35%),
                var(--fond);
            color: var(--texte);
            line-height: 1.6;
            min-height: 100vh;
        }

        .sr-only {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        header {
            position: relative;
            overflow: hidden;
            text-align: center;
            color: white;
            padding: 56px 15px 84px;
            background:
                radial-gradient(ellipse at 20% 0%, rgba(124, 58, 237, 0.55) 0%, transparent 55%),
                radial-gradient(ellipse at 85% 100%, rgba(34, 211, 238, 0.30) 0%, transparent 50%),
                linear-gradient(160deg, var(--nuit) 0%, var(--bleu-fonce) 70%, #3b2a8f 100%);
        }

        .etoiles,
        .etoiles::before,
        .etoiles::after {
            position: absolute;
            inset: 0;
            content: "";
            background-repeat: repeat;
            pointer-events: none;
        }

        .etoiles {
            background-image:
                radial-gradient(1.5px 1.5px at 20px 30px, #fff, transparent),
                radial-gradient(1px 1px at 90px 80px, #fff, transparent),
                radial-gradient(2px 2px at 160px 20px, #c4b5fd, transparent),
                radial-gradient(1px 1px at 230px 120px, #fff, transparent),
                radial-gradient(1.5px 1.5px at 60px 140px, #a5f3fc, transparent);
            background-size: 260px 170px;
            opacity: 0.8;
            animation: scintille 4s ease-in-out infinite alternate;
        }

        .etoiles::before {
            background-image:
                radial-gradient(1px 1px at 40px 60px, #fff, transparent),
                radial-gradient(2px 2px at 130px 110px, #fff, transparent),
                radial-gradient(1px 1px at 200px 40px, #a5f3fc, transparent);
            background-size: 310px 200px;
            animation: scintille 6s ease-in-out infinite alternate-reverse;
        }

        header::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 46px;
            background: var(--fond);
            clip-path: ellipse(60% 100% at 50% 100%);
        }

        @keyframes scintille {
            from { opacity: 0.35; }
            to   { opacity: 0.95; }
        }

        .logo-cadre {
            position: relative;
            z-index: 1;
            width: min(400px, 78vw);
            aspect-ratio: 1 / 1;
            margin: 0 auto 30px;
            border-radius: 50%;
        }

        .logo-cadre::before {
            content: "";
            position: absolute;
            inset: -10px;
            border-radius: 50%;
            background: conic-gradient(from 0deg, var(--cyan), var(--violet), #f0abfc, #fde68a, var(--cyan));
            animation: tourne 10s linear infinite;
        }

        .logo-cadre::after {
            content: "";
            position: absolute;
            inset: -50px;
            z-index: -1;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.55) 0%, rgba(34, 211, 238, 0.18) 45%, transparent 70%);
            animation: halo 5s ease-in-out infinite alternate;
        }

        .logo-officiel {
            position: relative;
            z-index: 1;
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            background: #fff;
            border: 6px solid #fff;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
        }

        @keyframes tourne {
            to { transform: rotate(360deg); }
        }

        @keyframes halo {
            from { opacity: 0.6; transform: scale(0.96); }
            to   { opacity: 1;   transform: scale(1.04); }
        }

        .slogan {
            position: relative;
            z-index: 1;
            display: inline-block;
            font-size: 17px;
            font-weight: 500;
            margin-top: 8px;
            padding: 9px 26px;
            color: #eef2ff;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 30px;
            background: rgba(255, 255, 255, 0.10);
            backdrop-filter: blur(6px);
        }

        .chips {
            position: relative;
            z-index: 1;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            list-style: none;
            margin-top: 20px;
        }

        .chips li {
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            color: #fff;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(4px);
            transition: background 0.2s, transform 0.2s;
        }

        .chips li:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
        }

        nav {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            padding: 10px;
            text-align: center;
            border-bottom: 1px solid #e2e8f0;
            box-shadow: 0 2px 10px rgba(15, 23, 42, 0.05);
        }

        nav a {
            display: inline-block;
            color: var(--bleu-fonce);
            text-decoration: none;
            font-weight: bold;
            padding: 7px 20px;
            border-radius: 20px;
            transition: background 0.2s, color 0.2s;
        }

        nav a:hover {
            background: linear-gradient(135deg, var(--bleu), var(--violet));
            color: white;
        }

        main {
            max-width: 880px;
            margin: 30px auto;
            padding: 0 20px;
            position: relative;
            z-index: 2;
        }

        .formulaire {
            background-color: white;
            padding: 36px;
            border-radius: 20px;
            box-shadow: 0 18px 50px rgba(30, 27, 90, 0.18);
            position: relative;
            scroll-margin-top: 70px;
        }

        .formulaire::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            border-radius: 20px 20px 0 0;
            background: linear-gradient(90deg, var(--cyan), var(--bleu), var(--violet));
        }

        .formulaire h2 {
            color: var(--bleu-fonce);
            font-size: 26px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .formulaire h2 .pastille {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--bleu), var(--violet));
            color: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: bold;
            box-shadow: 0 6px 14px rgba(79, 70, 229, 0.35);
        }

        .intro {
            color: var(--gris);
            margin-bottom: 8px;
        }

        fieldset {
            border: none;
            margin-top: 28px;
        }

        legend {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.2px;
            text-transform: uppercase;
            color: var(--violet);
            margin-bottom: 16px;
        }

        legend::after {
            content: "";
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, #c4b5fd, transparent);
        }

        .grille {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 22px;
        }

        .champ {
            display: flex;
            flex-direction: column;
        }

        .champ-complet {
            grid-column: 1 / -1;
        }

        label {
            font-weight: 600;
            margin-bottom: 7px;
            font-size: 14px;
            color: #334155;
        }

        input,
        select,
        textarea {
            width: 100%;
            padding: 12px 13px;
            border: 1.5px solid var(--bordure);
            border-radius: 10px;
            font-family: inherit;
            font-size: 15px;
            background-color: #f8fafc;
            color: var(--texte);
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        input:hover,
        select:hover,
        textarea:hover {
            border-color: #94a3b8;
        }

        input:focus,
        select:focus,
        textarea:focus {
            outline: none;
            background-color: #ffffff;
            border-color: var(--violet);
            box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.16);
        }

        textarea {
            min-height: 120px;
            resize: vertical;
        }

        .info {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 19px;
            height: 19px;
            margin-left: 6px;
            border-radius: 50%;
            background: var(--violet-clair);
            color: var(--violet);
            font-size: 12px;
            font-weight: 800;
            font-style: italic;
            font-family: Georgia, "Times New Roman", serif;
            letter-spacing: 0;
            text-transform: none;
            cursor: help;
            vertical-align: middle;
            transition: background 0.2s, color 0.2s, transform 0.2s;
        }

        .info:hover,
        .info:focus {
            outline: none;
            background: linear-gradient(135deg, var(--bleu), var(--violet));
            color: #fff;
            transform: scale(1.12);
        }

        .info::after {
            content: attr(data-tip);
            position: absolute;
            bottom: calc(100% + 12px);
            left: 50%;
            transform: translate(-50%, 6px);
            width: 250px;
            padding: 11px 14px;
            border-radius: 12px;
            background: linear-gradient(160deg, var(--nuit), var(--bleu-fonce));
            color: #eef2ff;
            font-family: "Segoe UI", Arial, Helvetica, sans-serif;
            font-size: 13px;
            font-weight: 500;
            font-style: normal;
            line-height: 1.5;
            letter-spacing: 0;
            text-transform: none;
            text-align: left;
            white-space: normal;
            box-shadow: 0 12px 30px rgba(11, 16, 48, 0.35);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
            z-index: 20;
        }

        .info::before {
            content: "";
            position: absolute;
            bottom: calc(100% + 4px);
            left: 50%;
            transform: translate(-50%, 6px) rotate(45deg);
            width: 12px;
            height: 12px;
            background: var(--bleu-fonce);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
            z-index: 21;
        }

        .info:hover::after,
        .info:focus::after {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, 0);
        }

        .info:hover::before,
        .info:focus::before {
            opacity: 1;
            visibility: visible;
            transform: translate(-50%, 0) rotate(45deg);
        }

        @media screen and (max-width: 600px) {
            .info::after {
                width: min(250px, 72vw);
                left: -8px;
                transform: translate(0, 6px);
            }

            .info:hover::after,
            .info:focus::after {
                transform: translate(0, 0);
            }

            .info::before {
                left: 9px;
            }
        }

        .actions {
            display: flex;
            gap: 12px;
            margin-top: 34px;
        }

        button {
            padding: 15px 24px;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
        }

        button:active {
            transform: translateY(1px);
        }

        .btn-enregistrer {
            background: linear-gradient(135deg, var(--bleu) 0%, var(--violet) 100%);
            color: white;
            flex: 1;
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.35);
        }

        .btn-enregistrer:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(79, 70, 229, 0.45);
        }

        .btn-effacer {
            background-color: #fff1f2;
            color: #be123c;
            border: 1.5px solid #fecdd3;
        }

        .btn-effacer:hover {
            background-color: #e11d48;
            border-color: #be123c;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(225, 29, 72, 0.3);
        }

        footer {
            text-align: center;
            padding: 34px 20px 30px;
            color: #c7d2fe;
            font-size: 13px;
            margin-top: 40px;
            background: linear-gradient(160deg, var(--nuit), var(--bleu-fonce));
        }

        footer .logo-mini {
            width: 44px;
            height: 44px;
            margin-bottom: 8px;
        }

        footer .nom {
            font-weight: 800;
            font-size: 16px;
            color: white;
            margin-bottom: 6px;
        }

        footer strong {
            color: #fff;
        }

        @media screen and (max-width: 600px) {
            header {
                padding: 40px 12px 80px;
            }

            main {
                margin-top: 24px;
                padding: 0 12px;
            }

            .formulaire {
                padding: 24px 16px;
            }

            .formulaire h2 {
                font-size: 22px;
            }

            .grille {
                grid-template-columns: 1fr;
                gap: 16px;
            }

            .champ-complet {
                grid-column: auto;
            }

            .actions {
                flex-direction: column;
            }

            button {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .etoiles,
            .etoiles::before,
            .logo-cadre::before,
            .logo-cadre::after {
                animation: none;
            }
        }

        /* ===== Animations et effets supplémentaires ===== */

        @keyframes apparition {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @keyframes flotte {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-5px); }
        }

        @keyframes brille {
            from { transform: translateX(-120%) skewX(-20deg); }
            to   { transform: translateX(260%) skewX(-20deg); }
        }

        .logo-cadre { animation: apparition 0.9s ease backwards; }
        .slogan     { animation: apparition 0.9s 0.15s ease backwards; }
        .chips      { animation: apparition 0.9s 0.3s ease backwards; }
        .formulaire { animation: apparition 0.9s 0.45s ease backwards; }

        .logo-cadre {
            transition: transform 0.4s ease, filter 0.4s ease;
        }
        .logo-cadre:hover {
            transform: scale(1.04) rotate(-1.5deg);
            filter: drop-shadow(0 0 25px rgba(139, 92, 246, 0.7));
        }

        .slogan {
            transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
        }
        .slogan:hover {
            transform: translateY(-3px) scale(1.03);
            background: rgba(255, 255, 255, 0.2);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
        }

        .chips li {
            cursor: default;
            animation: flotte 4s ease-in-out infinite;
        }
        .chips li:nth-child(2) { animation-delay: 0.5s; }
        .chips li:nth-child(3) { animation-delay: 1s; }
        .chips li:nth-child(4) { animation-delay: 1.5s; }
        .chips li:hover {
            animation: none;
            background: linear-gradient(135deg, var(--bleu), var(--violet));
            border-color: transparent;
            box-shadow: 0 8px 20px rgba(124, 58, 237, 0.45);
            transform: translateY(-4px) scale(1.07);
        }

        nav a {
            position: relative;
            transition: background 0.3s, color 0.3s, transform 0.3s, box-shadow 0.3s;
        }
        nav a:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(79, 70, 229, 0.35);
        }

        .formulaire {
            border: 1px solid rgba(124, 58, 237, 0.08);
            transition: box-shadow 0.4s ease, transform 0.4s ease;
        }
        .formulaire:hover {
            box-shadow: 0 26px 70px rgba(79, 70, 229, 0.28);
            transform: translateY(-3px);
        }

        .formulaire h2 .pastille {
            transition: transform 0.4s ease, box-shadow 0.4s ease;
        }
        .formulaire h2:hover .pastille {
            transform: rotate(180deg) scale(1.1);
            box-shadow: 0 10px 22px rgba(79, 70, 229, 0.5);
        }

        fieldset {
            padding: 18px 18px 22px;
            margin-top: 22px;
            border-radius: 14px;
            border: 1px solid transparent;
            transition: background 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
        }
        fieldset:hover,
        fieldset:focus-within {
            background: linear-gradient(135deg, rgba(219, 234, 254, 0.35), rgba(237, 233, 254, 0.35));
            border-color: rgba(124, 58, 237, 0.18);
            box-shadow: 0 8px 22px rgba(79, 70, 229, 0.08);
        }

        label {
            transition: color 0.25s ease, transform 0.25s ease;
        }
        .champ:hover label,
        .champ:focus-within label {
            color: var(--violet);
            transform: translateX(3px);
        }

        input,
        select,
        textarea {
            transition: border-color 0.25s, box-shadow 0.25s, background 0.25s, transform 0.25s;
        }
        input:hover,
        select:hover,
        textarea:hover {
            background-color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(30, 58, 138, 0.1);
        }
        input:focus,
        select:focus,
        textarea:focus {
            transform: translateY(-2px);
        }
        select {
            cursor: pointer;
        }

        .info:hover,
        .info:focus {
            animation: rebond 0.5s ease;
        }
        @keyframes rebond {
            0%   { transform: scale(1); }
            40%  { transform: scale(1.35); }
            100% { transform: scale(1.12); }
        }

        button {
            position: relative;
            overflow: hidden;
        }
        .btn-enregistrer::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 40%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
            transform: translateX(-120%) skewX(-20deg);
            pointer-events: none;
        }
        .btn-enregistrer:hover::after {
            animation: brille 0.9s ease;
        }
        .btn-enregistrer:hover {
            transform: translateY(-3px) scale(1.01);
        }
        .btn-effacer:hover {
            transform: translateY(-3px) rotate(-1deg);
        }

        footer .logo-mini {
            transition: transform 0.8s ease;
        }
        footer:hover .logo-mini {
            transform: rotate(360deg) scale(1.15);
        }
        footer p {
            transition: color 0.3s ease, transform 0.3s ease;
        }
        footer p:hover {
            color: #fff;
            transform: translateX(4px);
        }

        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #e2e8f0; }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, var(--bleu), var(--violet));
            border-radius: 10px;
        }

        ::selection {
            background: var(--violet);
            color: #fff;
        }

        @media (prefers-reduced-motion: reduce) {
            .logo-cadre, .slogan, .chips, .formulaire, .chips li {
                animation: none;
            }
            .btn-enregistrer:hover::after {
                animation: none;
            }
            .formulaire:hover, input:hover, select:hover, textarea:hover,
            .logo-cadre:hover, button:hover {
                transform: none;
            }
        }
    </style>

    <script>
       
        const listesDeroulantes = {
            priorite: [
                { idPriorite: 1, priorite: "Très faible" },
                { idPriorite: 2, priorite: "Faible" },
                { idPriorite: 3, priorite: "Moyenne" },
                { idPriorite: 4, priorite: "Importante" },
                { idPriorite: 5, priorite: "Urgente" }
            ],
            typeTache: [
                { idTypeTache: 1, typeTache: "Cours" },
                { idTypeTache: 2, typeTache: "Devoir à déposer" },
                { idTypeTache: 3, typeTache: "Projet en groupe" },
                { idTypeTache: 4, typeTache: "Démarche administrative" },
                { idTypeTache: 5, typeTache: "Réunion professionnelle" },
                { idTypeTache: 6, typeTache: "Réunion pédagogique" },
                { idTypeTache: 7, typeTache: "Conception ou production" },
                { idTypeTache: 8, typeTache: "Communication" }
            ],
            environnement: [
                { idEnvironnement: 1, environnement: "École" },
                { idEnvironnement: 2, environnement: "Entreprise" },
                { idEnvironnement: 3, environnement: "École et entreprise" }
            ],
            statut: [
                { idStatut: 1, statut: "À faire" },
                { idStatut: 2, statut: "En cours" },
                { idStatut: 3, statut: "En attente" },
                { idStatut: 4, statut: "Terminée" },
                { idStatut: 5, statut: "Annulée" }
            ]
        };

       
        function afficherOptions(selectId, options, proprieteId, proprieteTexte) {
            const liste = document.getElementById(selectId);

            options.forEach(function (item) {
                const option = document.createElement("option");
                option.value = item[proprieteId];
                option.textContent = item[proprieteTexte];
                liste.appendChild(option);
            });
        }

       
        function saveTask() {

            
            let formulaire = document.getElementById("formTache");
            if (!formulaire.checkValidity()) {
                formulaire.reportValidity();   
                return;                        
            }

            
            let libelle = document.getElementById("libelle").value.trim();
            let description = document.getElementById("description").value.trim();
            let dateCreation = document.getElementById("dateCreation").value;
            let dateEcheance = document.getElementById("dateEcheance").value;
            let tempsEstimeMinutes = Number(document.getElementById("tempsEstimeMinutes").value);
            let idPriorite = Number(document.getElementById("idPriorite").value);
            let idTypeTache = Number(document.getElementById("idTypeTache").value);
            let idEnvironnement = Number(document.getElementById("idEnvironnement").value);
            let idStatut = Number(document.getElementById("idStatut").value);

            console.log("Champs lus :", libelle, description, dateCreation, dateEcheance,
                tempsEstimeMinutes, idPriorite, idTypeTache, idEnvironnement, idStatut);

           
            let taches = [];
            let donneesEnregistrees = localStorage.getItem("taches");

            if (donneesEnregistrees !== null) {
               
                taches = JSON.parse(donneesEnregistrees);
            }
            console.log("Tâches déjà enregistrées :", taches);

           
            let idTache = 1;

            if (taches.length > 0) {
                let derniereTache = taches[taches.length - 1];
                idTache = Number(derniereTache.idTache) + 1;
            }

            let nouvelleTache = {
                idTache: idTache,
                libelle: libelle,
                description: description,
                dateCreation: dateCreation,
                dateEcheance: dateEcheance,
                tempsEstimeMinutes: tempsEstimeMinutes,
                idPriorite: idPriorite,
                idTypeTache: idTypeTache,
                idEnvironnement: idEnvironnement,
                idStatut: idStatut
            };
            console.log("Nouvelle tâche :", nouvelleTache);

         
            taches.push(nouvelleTache);
            console.log("Liste après ajout :", taches);

           
            let donnees = JSON.stringify(taches);
            localStorage.setItem("taches", donnees);

           
            formulaire.reset();
            alert("Tâche n°" + idTache + " enregistrée !");
        }

        
