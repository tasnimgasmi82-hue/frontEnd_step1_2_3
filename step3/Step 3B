                '<stop offset="0" stop-color="#22d3ee"/><stop offset=".5" stop-color="#2563eb"/><stop offset="1" stop-color="#7c3aed"/>' +
                '</linearGradient>' +
                '<linearGradient id="f" x1="0" y1="0" x2="1" y2="1">' +
                '<stop offset="0" stop-color="#0b1030"/><stop offset="1" stop-color="#1e3a8a"/>' +
                '</linearGradient>' +
                '</defs>' +
                '<rect width="400" height="400" fill="url(#f)"/>' +
                '<ellipse cx="200" cy="170" rx="150" ry="48" fill="none" stroke="#c4b5fd" stroke-width="9" opacity=".5" transform="rotate(-20 200 170)"/>' +
