                '<path d="M10 170 A150 48 0 0 0 390 170" fill="none" stroke="#c4b5fd" stroke-width="9" stroke-linecap="round" transform="rotate(-20 200 170)"/>' +
                '<path d="M158 175 l32 32 l58 -64" fill="none" stroke="#fff" stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/>' +
                '<text x="200" y="320" text-anchor="middle" font-family="Segoe UI, Arial, sans-serif" font-size="46" font-weight="800" fill="#fff">SYNVAverse</text>' +
